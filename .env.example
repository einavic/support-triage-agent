ANTHROPIC_API_KEY=your-anthropic-api-key-here
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
# Confirmation emails to customers after an escalation (via resend.com).
# Test mode: every email goes to EMAIL_TEST_RECIPIENT instead of the customer; if either is unset, no email is sent.
RESEND_API_KEY=your-resend-api-key-here
EMAIL_TEST_RECIPIENT=you@example.com
# Optional - only needed once src/utils/embeddings.ts is wired into retrieval
# VOYAGE_API_KEY=your-voyage-api-key-here
