{
  "name": "support-triage-agent",
  "version": "0.1.0",
  "description": "Agentic customer support triage assistant built with Claude tool use: answers from a knowledge base, looks up accounts, and escalates to a human via Slack when needed.",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "scenarios": "tsx scenarios/scenarios.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^16.4.5",
    "voyageai": "^0.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
